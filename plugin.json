{
  "id": "io.github.sirmmo.python",
  "name": "Python",
  "version": "0.3.0",
  "description": "Python scripting for GridCraft, WordCraft and DeckCraft: scripts and a console that edit the open document through `doc`, Python in formulas (PY.EVAL) and ready-made helpers. Standard library only; needs python3 (3.8 or later).",
  "author": "Marco Montanari",
  "homepage": "https://github.com/sirmmo/gridcraft-python-plugin",
  "apps": [
    "gridcraft",
    "wordcraft",
    "deckcraft"
  ],
  "run": {
    "command": "python3",
    "args": [
      "main.py"
    ]
  },
  "requires": {
    "apps": {
      "gridcraft": ">=0.7.0",
      "wordcraft": ">=0.7.0",
      "deckcraft": ">=0.7.0"
    },
    "protocol": ">=1.2",
    "features": [
      "dialogs",
      "document"
    ]
  },
  "events": [
    "documentOpened",
    "documentSaved",
    "documentClosed"
  ],
  "functions": [
    {
      "name": "PY.EVAL",
      "signature": "PY.EVAL(code, [x], [y], [z], ...)",
      "description": "The value of Python code, with the arguments as x, y, z (all of them: args). A range is a list of rows. Trusted workbooks only",
      "minArgs": 1,
      "maxArgs": 255,
      "timeoutMs": 30000
    },
    {
      "name": "PY.VERSION",
      "signature": "PY.VERSION()",
      "description": "The add-in and Python versions",
      "minArgs": 0,
      "maxArgs": 0
    },
    {
      "name": "PY.TWICE",
      "signature": "PY.TWICE(value)",
      "description": "Doubles a number, or each number of a range",
      "minArgs": 1,
      "maxArgs": 1
    },
    {
      "name": "PY.MEDIAN",
      "signature": "PY.MEDIAN(number1, [number2], ...)",
      "description": "Median, computed by Python's statistics module",
      "minArgs": 1,
      "maxArgs": 255
    },
    {
      "name": "PY.STATS",
      "signature": "PY.STATS(number1, [number2], ...)",
      "description": "A spilled table: count, sum, mean, median, min, max, stdev",
      "minArgs": 1,
      "maxArgs": 255
    },
    {
      "name": "PY.REGEX",
      "signature": "PY.REGEX(text, pattern, [group])",
      "description": "The first match of a Python regular expression, or #N/A",
      "minArgs": 2,
      "maxArgs": 3
    },
    {
      "name": "PY.SPLIT",
      "signature": "PY.SPLIT(text, [separator])",
      "description": "Splits text into a spilled row (default: on whitespace)",
      "minArgs": 1,
      "maxArgs": 2
    }
  ],
  "commands": [
    {
      "id": "runScript",
      "label": "Run Python Script",
      "description": "Runs Python with `doc` (this document) and `x` (the selection); print() output and the last line's value show after it. One undo step. Trusted documents only",
      "params": "{code? | file?, output?: show|below|sheet (GridCraft), timeout?: seconds} (no params: asks)"
    },
    {
      "id": "runFile",
      "label": "Run Python File",
      "description": "Runs a .py file with `doc` and `x`. Trusted documents only",
      "params": "{path} (no params: asks)"
    },
    {
      "id": "console",
      "label": "Python Console",
      "description": "Evaluates Python in a workspace that keeps what you define, and shows the result. Trusted documents only",
      "params": "{code?} (no params: asks) → result.output, result.value"
    },
    {
      "id": "trust",
      "label": "Trust This Document",
      "description": "Turns Python on for the active document, after spelling out the risk"
    },
    {
      "id": "trustConfirm",
      "label": "Trust This Document (confirmed)",
      "description": "Trusts the active document without asking (what Trust's OK runs)",
      "params": "{path, name}: the active document's, as a check"
    },
    {
      "id": "untrust",
      "label": "Stop Trusting",
      "description": "Turns Python off for the active document"
    },
    {
      "id": "trusted",
      "label": "Trusted Documents",
      "description": "Lists the trusted documents, to take some off the list"
    },
    {
      "id": "untrustPaths",
      "label": "Remove Trusted Documents",
      "description": "Takes documents off the trusted list",
      "params": "{ids: [path, ...]}"
    },
    {
      "id": "about",
      "label": "About Python",
      "description": "The add-in and Python versions, and whether Python is on for this document"
    },
    {
      "id": "titleCase",
      "label": "Title Case",
      "description": "Title-cases the text in the selection"
    },
    {
      "id": "trim",
      "label": "Trim Spaces",
      "description": "Removes extra spaces from the text in the selection"
    },
    {
      "id": "statsTable",
      "label": "Statistics",
      "description": "Writes a statistics table to the right of the selection"
    },
    {
      "id": "fillFibonacci",
      "label": "Fibonacci",
      "description": "Fills the Fibonacci numbers down from the active cell",
      "params": "{count?: 1-1000, default 10}"
    },
    {
      "id": "textStats",
      "label": "Text Statistics",
      "description": "Words, sentences and average word length of the selection (or the paragraph)"
    }
  ],
